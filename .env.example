# Copy to `dashboard/.env.local` (git-ignored) and fill in.
# Every value here is server-only — nothing is prefixed NEXT_PUBLIC_, and
# nothing in this file may be imported from a Client Component.

# --- Supabase -----------------------------------------------------------------
# Project URL and the SERVICE ROLE key (Settings -> API in the Supabase
# dashboard). The service-role key bypasses row-level security; this dashboard
# is an internal admin tool and only ever calls Supabase from the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (email + password login, gated by the allowed_users table) ----------
# The ANON key (same Settings -> API page). Safe by design -- Auth is meant to
# be called with it -- but still only ever used server-side here (Server
# Actions / Route Handlers / proxy), so it stays unprefixed like everything
# else in this file.
#
# Accounts are created via the Supabase Admin API (service-role key), not a
# public sign-up form -- there isn't one. Add each new person to both
# Supabase Auth and the `allowed_users` table.
SUPABASE_ANON_KEY=

# --- Twilio -------------------------------------------------------------------
# Account SID + auth token from the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SID of the ONE shared Elastic SIP Trunk (starts with TK). Create it once by
# hand, set its Origination URI to sip:<livekit-host>:5060, and the dashboard
# attaches and detaches numbers on it from then on. See infra/README.md step 5.
TWILIO_SIP_TRUNK_SID=

# --- LiveKit ------------------------------------------------------------------
# Same key/secret pair as infra/.env — that's how the dashboard authenticates
# against the self-hosted LiveKit server. Used only to read SIP trunk/dispatch
# status and to keep number-restricted trunks in sync.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudinary (call recordings) --------------------------------------------
# The worker uploads each call's audio to Cloudinary as an *authenticated*
# asset and stores the URL in call_logs.recording_url. Authenticated assets
# refuse unsigned requests, so the dashboard has to sign a playback URL with
# the same account's API secret. Same values as the worker's. Optional: without
# them the call detail page shows a notice instead of a working player.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web widget ----------------------------------------------------------------
# Limits on the embeddable voice widget (/widget.js), which anyone can start a
# call through without signing in. Both optional.
#
# Widget calls one agent may take per UTC day, counted from call_logs.
WIDGET_DAILY_CAP=200
# Live calls across every channel (phone, test and widget) before a new widget
# visitor is told all agents are busy. Match it to how many jobs the worker
# can run at once.
MAX_CONCURRENT_CALLS=3
